# Copy to .env. All external credentials below are intentionally empty placeholders.
# Local disposable database; no account or data is included.
DATABASE_URL=sqlite:///./visionary.local.db
# Replace with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=replace-with-a-new-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:5173

# Image API: configure a provider compatible with the request format in backend/api/image.py.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://image-api.example.invalid/v1
# Optional prompt enhancement (Qwen); otherwise uses OPENAI settings.
DASHSCOPE_API_KEY=

# Required for image storage; use your own COS credentials and bucket.
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
TENCENT_CLOUD_COS_REGION=
TENCENT_CLOUD_COS_BUCKET=

# Optional email verification / password reset
SMTP_SERVER=smtp.example.invalid
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Optional payment adapter (not required for local browsing)
PAYLE_PID=
PAYLE_KEY=
PAYLE_API_URL=https://payments.example.invalid/submit.php
PAYLE_NOTIFY_URL=http://localhost:8000/api/payment/notify
PAYLE_RETURN_URL=http://localhost:5173/profile
